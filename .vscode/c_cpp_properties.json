{
  "configurations": [
    {
      "name": "Mac",
      "includePath": ["${default}", "${workspaceFolder}/includes"],
      "defines": ["BUILD_PATH=${workspaceFolder}/out/build/loyalty_backend"],
      "macFrameworkPath": [
        "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/System/Library/Frameworks",
        "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/System/Library/SubFrameworks"
      ],
      "compilerPath": "/usr/bin/clang",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "macos-clang-arm64",
      "compileCommands": "${workspaceFolder}/out/build/loyalty_backend/compile_commands.json"
    }
  ],
  "version": 4
}
